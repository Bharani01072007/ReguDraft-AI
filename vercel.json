{
  "experimentalServices": {
    "frontend": {
      "routePrefix": "/",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://regudraft-ai.onrender.com/api/v1/:path*"
    },
    {
      "source": "/((?!api/|static/).*)",
      "destination": "/index.html"
    }
  ]
}

